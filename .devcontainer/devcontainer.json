{
  "name": "Temi VMS",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  "features": {
    "ghcr.io/devcontainers/features/postgresql:1": {
      "version": "15"
    }
  },

  "postCreateCommand": "npm --prefix backend install && npm --prefix frontend install && bash .devcontainer/db-init.sh",

  "forwardPorts": [5000, 5173],
  "portsAttributes": {
    "5000": { "label": "Backend API", "visibility": "public", "onAutoForward": "silent" },
    "5173": { "label": "Frontend", "visibility": "public", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
