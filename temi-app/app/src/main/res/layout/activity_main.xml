<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080000">

    <!-- ── Top brand bar ─────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical"
        android:background="#B91C1C">

        <View
            android:id="@+id/vConnectionDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#FF9999"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NANTA TECH LIMITED  ·  Visitor Reception"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.06"/>

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 --"
            android:textSize="12sp"
            android:textColor="#FFCCCC"/>
    </LinearLayout>

    <!-- ── Main content ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: face + stats -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="38"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0d0000">

            <com.vms.temi.ui.TemiFaceView
                android:id="@+id/temiFace"
                android:layout_width="190dp"
                android:layout_height="190dp"/>

            <!-- Visit counter -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvVisitCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textColor="#DC2626"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISITS TODAY"
                    android:textSize="9sp"
                    android:textColor="#5a0000"
                    android:letterSpacing="0.22"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2a0000"/>

        <!-- Right: clock + welcome + action -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="62"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Clock section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00 AM"
                    android:textSize="38sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading…"
                    android:textSize="12sp"
                    android:textColor="#FF7777"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Red separator line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#280000"/>

            <!-- Welcome text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WELCOME TO"
                    android:textSize="10sp"
                    android:textColor="#DC2626"
                    android:letterSpacing="0.20"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nanta Tech Limited"
                    android:textSize="30sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I am Temi, your visitor assistant"
                    android:textSize="14sp"
                    android:textColor="#FF7777"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Red separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#280000"/>

            <!-- Status + button section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Initializing…"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"/>

                <!-- OTP Check-In button (primary) -->
                <Button
                    android:id="@+id/btnEnterOTP"
                    android:layout_width="220dp"
                    android:layout_height="50dp"
                    android:text="ENTER OTP"
                    android:textSize="14sp"
                    android:letterSpacing="0.08"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#DC2626"
                    android:elevation="6dp"
                    android:layout_marginTop="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Have an OTP from your approval email"
                    android:textSize="10sp"
                    android:textColor="#5a0000"
                    android:layout_marginTop="6dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="220dp"
                    android:layout_height="1dp"
                    android:background="#280000"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Walk-in button -->
                <Button
                    android:id="@+id/btnWalkIn"
                    android:layout_width="220dp"
                    android:layout_height="46dp"
                    android:text="WALK-IN VISIT"
                    android:textSize="13sp"
                    android:letterSpacing="0.06"
                    android:textColor="#FF9999"
                    android:backgroundTint="#2a0000"
                    android:elevation="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No OTP? Register here for an impromptu visit"
                    android:textSize="10sp"
                    android:textColor="#5a0000"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── Footer ────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="#0d0000">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Serial: 00126040079"
            android:textSize="9sp"
            android:textColor="#3a0000"/>

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Connecting…"
            android:textSize="9sp"
            android:textColor="#5a0000"/>
    </LinearLayout>

</LinearLayout>
