<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080000">

    <!-- Left panel: Temi face -->
    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0d0000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/divider"
        app:layout_constraintWidth_percent="0.35">

        <com.vms.temi.ui.TemiFaceView
            android:id="@+id/temiFace"
            android:layout_width="160dp"
            android:layout_height="160dp" />

        <TextView
            android:id="@+id/tvFaceMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your OTP"
            android:textSize="14sp"
            android:textColor="#CC0000"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="20dp" />

        <TextView
            android:id="@+id/tvSubMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check your email for\nthe 6-digit code"
            android:textSize="11sp"
            android:textColor="#880000"
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#1a0000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.35" />

    <!-- Right panel: email + OTP input -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingVertical="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Step: email input -->
        <LinearLayout
            android:id="@+id/stepEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:text="Your Email Address"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:text="Enter the email used when booking your visit"
                android:textSize="12sp"
                android:textColor="#880000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="textEmailAddress"
                android:hint="you@email.com"
                android:textColor="#FFFFFF"
                android:textColorHint="#550000"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_input"
                android:imeOptions="actionNext"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnEmailContinue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Continue →"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:backgroundTint="#CC0000"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- Step: OTP input -->
        <LinearLayout
            android:id="@+id/stepOTP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:text="Enter OTP"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvEmailDisplay"
                android:text=""
                android:textSize="11sp"
                android:textColor="#880000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"/>

            <!-- Six digit boxes in a row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <EditText android:id="@+id/otp1" style="@style/OTPDigitBox" />
                <EditText android:id="@+id/otp2" style="@style/OTPDigitBox" />
                <EditText android:id="@+id/otp3" style="@style/OTPDigitBox" />
                <EditText android:id="@+id/otp4" style="@style/OTPDigitBox" />
                <EditText android:id="@+id/otp5" style="@style/OTPDigitBox" />
                <EditText android:id="@+id/otp6" style="@style/OTPDigitBox" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOTPError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF4444"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="10dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Verify OTP"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:backgroundTint="#CC0000"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btnBackToEmail"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Change email"
                android:textColor="#880000"
                android:textSize="11sp"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Step: validating spinner -->
        <LinearLayout
            android:id="@+id/stepValidating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#CC0000"/>

            <TextView
                android:text="Verifying OTP…"
                android:textColor="#CC0000"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Auto-close countdown -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="#330000"
            android:layout_marginTop="24dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
