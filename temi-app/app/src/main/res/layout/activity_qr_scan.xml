<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dark dim overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- QR scan frame -->
    <View
        android:id="@+id/scanOverlay"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/qr_scan_frame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Animated scan line -->
    <View
        android:id="@+id/scanLine"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@drawable/scan_line_gradient"
        android:alpha="0.9"
        app:layout_constraintStart_toStartOf="@+id/scanOverlay"
        app:layout_constraintEnd_toEndOf="@+id/scanOverlay"
        app:layout_constraintTop_toTopOf="@+id/scanOverlay"/>

    <!-- Corner flash overlay when QR detected -->
    <View
        android:id="@+id/scanFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#3322C55E"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@+id/scanOverlay"
        app:layout_constraintBottom_toBottomOf="@+id/scanOverlay"
        app:layout_constraintStart_toStartOf="@+id/scanOverlay"
        app:layout_constraintEnd_toEndOf="@+id/scanOverlay"/>

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:background="#E6000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:text="NANTA TECH LIMITED"
            android:textSize="10sp"
            android:textColor="#DC2626"
            android:letterSpacing="0.22"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="QR Code Check-In"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>

        <TextView
            android:id="@+id/tvInstruction"
            android:text="Hold your QR code steady inside the frame"
            android:textSize="12sp"
            android:textColor="#FFAAAA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#E6000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvScanStatus"
            android:text="Scanning…"
            android:textSize="13sp"
            android:textColor="#FF9999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvCountdown"
            android:text=""
            android:textSize="11sp"
            android:textColor="#660000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>

        <!-- Torch + Manual entry row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnTorch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="💡 Torch"
                android:textSize="11sp"
                android:textColor="#FF9999"
                android:backgroundTint="#2a0000"
                android:layout_marginEnd="12dp"/>

            <Button
                android:id="@+id/btnManualEntry"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⌨ Enter Code"
                android:textSize="11sp"
                android:textColor="#FF9999"
                android:backgroundTint="#2a0000"/>
        </LinearLayout>

        <TextView
            android:text="Visitor Management System  ·  Powered by Temi"
            android:textSize="9sp"
            android:textColor="#440000"
            android:letterSpacing="0.04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
