<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080000">

    <!-- Top brand bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical"
        android:background="#B91C1C">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NANTA TECH LIMITED  ·  Walk-In Registration"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.06"/>

        <TextView
            android:id="@+id/tvStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1 of 2"
            android:textSize="11sp"
            android:textColor="#FFCCCC"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- Main content row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Temi face + instruction -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="35"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0d0000">

            <com.vms.temi.ui.TemiFaceView
                android:id="@+id/temiFace"
                android:layout_width="150dp"
                android:layout_height="150dp"/>

            <TextView
                android:id="@+id/tvFaceInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Let me help you\ncheck in today!"
                android:textSize="12sp"
                android:textColor="#FF7777"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2a0000"/>

        <!-- Right: ViewFlipper with steps -->
        <ViewFlipper
            android:id="@+id/viewFlipper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="65">

            <!-- ── Step 1: Visitor Details ── -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR DETAILS"
                        android:textSize="10sp"
                        android:textColor="#DC2626"
                        android:letterSpacing="0.22"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Walk-In Registration"
                        android:textSize="24sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="18dp"/>

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name *"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5a0000"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Phone Number"
                        android:inputType="phone"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5a0000"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etCompany"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Company (optional)"
                        android:inputType="textCapWords"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5a0000"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textSize="15sp"
                        android:layout_marginBottom="20dp"/>

                    <Button
                        android:id="@+id/btnNext"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="NEXT →"
                        android:textSize="14sp"
                        android:letterSpacing="0.08"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#DC2626"/>
                </LinearLayout>
            </ScrollView>

            <!-- ── Step 2: Select Host ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:paddingTop="18dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHO TO VISIT"
                    android:textSize="10sp"
                    android:textColor="#DC2626"
                    android:letterSpacing="0.22"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a Person"
                    android:textSize="24sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search by name or department…"
                    android:inputType="text"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5a0000"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/employeeListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </ScrollView>

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="← BACK"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3a0000"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- ── Step 3: Waiting / QR Display ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Waiting for approval panel -->
                <LinearLayout
                    android:id="@+id/waitingPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOTIFYING"
                        android:textSize="10sp"
                        android:textColor="#DC2626"
                        android:letterSpacing="0.22"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvWaitingHost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="26sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:gravity="center"/>

                    <ProgressBar
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="18dp"
                        android:indeterminateTint="#DC2626"/>

                    <TextView
                        android:id="@+id/tvWaitingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waiting for approval…"
                        android:textSize="14sp"
                        android:textColor="#FF7777"
                        android:gravity="center"
                        android:layout_marginTop="14dp"/>

                    <TextView
                        android:id="@+id/tvWaitCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="#5a0000"
                        android:gravity="center"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- QR approved panel (hidden until approved) -->
                <LinearLayout
                    android:id="@+id/qrPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ APPROVED"
                        android:textSize="11sp"
                        android:textColor="#22C55E"
                        android:letterSpacing="0.14"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Visit is Confirmed"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:gravity="center"/>

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="fitCenter"
                        android:background="#FFFFFF"
                        android:padding="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show this QR code to the scanner to check in"
                        android:textSize="12sp"
                        android:textColor="#FF9999"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvQrCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="#5a0000"
                        android:gravity="center"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="CANCEL"
                    android:textSize="11sp"
                    android:textColor="#FF7777"
                    android:backgroundTint="#1a0000"
                    android:layout_marginTop="18dp"/>
            </LinearLayout>

        </ViewFlipper>
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="#0d0000">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Visitor Management System  ·  Walk-In Check-In"
            android:textSize="9sp"
            android:textColor="#3a0000"/>

        <TextView
            android:id="@+id/tvWalkInStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="#5a0000"/>
    </LinearLayout>

</LinearLayout>
